{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Fichiers compagnons d'une tuile fixe (art/maps/tiles/chunk_<gx>_<gy>/)",
  "definitions": {
    "meta": {
      "type": "object",
      "required": ["chunkId", "gx", "gy", "worldX", "worldY", "tileSize", "coveredRect", "isPartial", "pngOffsetInCell", "sources", "generatedAt"],
      "properties": {
        "chunkId": { "type": "string", "pattern": "^chunk_-?\\d+_-?\\d+$" },
        "gx": { "type": "integer" },
        "gy": { "type": "integer" },
        "worldX": { "type": "integer" },
        "worldY": { "type": "integer" },
        "tileSize": { "type": "integer", "minimum": 1 },
        "coveredRect": { "$ref": "#/definitions/rect" },
        "isPartial": { "type": "boolean" },
        "pngOffsetInCell": { "$ref": "#/definitions/point" },
        "sources": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["organicChunkId", "contributedRectPx"],
            "properties": {
              "organicChunkId": { "type": "string" },
              "contributedRectPx": { "$ref": "#/definitions/rect" }
            }
          }
        },
        "generatedAt": { "type": "string", "format": "date-time" }
      }
    },
    "connectors": {
      "type": "object",
      "required": ["chunkId", "connectors"],
      "properties": {
        "chunkId": { "type": "string" },
        "connectors": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["type", "absoluteX", "absoluteY", "widthPx", "required", "sourceChunk", "sourceDirection"],
            "properties": {
              "type": { "type": "string", "enum": ["road", "river", "cliff", "forest", "bridge", "tunnel"] },
              "absoluteX": { "type": "integer" },
              "absoluteY": { "type": "integer" },
              "widthPx": { "type": "number" },
              "required": { "type": "boolean" },
              "transitionTheme": { "type": ["string", "null"] },
              "sourceChunk": { "type": "string" },
              "sourceDirection": { "type": "string", "enum": ["north", "south", "east", "west"] }
            }
          }
        }
      }
    },
    "collisions": {
      "type": "object",
      "required": ["chunkId", "colliders"],
      "properties": {
        "chunkId": { "type": "string" },
        "colliders": { "type": "array" },
        "note": { "type": "string" }
      }
    },
    "objects": {
      "type": "object",
      "required": ["chunkId", "objects"],
      "properties": {
        "chunkId": { "type": "string" },
        "objects": { "type": "array" },
        "note": { "type": "string" }
      }
    },
    "navigation": {
      "type": "object",
      "required": ["chunkId", "walkableRects"],
      "properties": {
        "chunkId": { "type": "string" },
        "walkableRects": { "type": "array" },
        "note": { "type": "string" }
      }
    },
    "rect": {
      "type": "object",
      "required": ["x", "y", "width", "height"],
      "properties": {
        "x": { "type": "integer" },
        "y": { "type": "integer" },
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 }
      }
    },
    "point": {
      "type": "object",
      "required": ["x", "y"],
      "properties": {
        "x": { "type": "integer" },
        "y": { "type": "integer" }
      }
    }
  }
}
