{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Eluminia world.json",
  "type": "object",
  "required": ["worldId", "originChunk", "chunks"],
  "properties": {
    "worldId": { "type": "string" },
    "originChunk": { "type": "string" },
    "chunks": {
      "type": "object",
      "additionalProperties": { "$ref": "#/definitions/chunk" }
    }
  },
  "definitions": {
    "chunk": {
      "type": "object",
      "required": ["id", "theme", "source", "widthPx", "heightPx", "status", "neighbors", "connectors", "originPx", "paintedRegionPx"],
      "properties": {
        "id": { "type": "string", "pattern": "^-?\\d+_-?\\d+$" },
        "theme": { "type": "string" },
        "source": { "type": "string" },
        "widthPx": { "type": "integer", "minimum": 1 },
        "heightPx": { "type": "integer", "minimum": 1 },
        "status": { "type": "string", "enum": ["approved", "pending", "rejected"] },
        "note": { "type": "string" },
        "originPx": {
          "type": "object",
          "description": "Position absolue du pixel (0,0) local du master de ce chunk, dans l'espace-monde partagé (voir tile-grid.mjs).",
          "required": ["x", "y"],
          "properties": {
            "x": { "type": "integer" },
            "y": { "type": "integer" }
          }
        },
        "paintedRegionPx": {
          "type": "object",
          "description": "Rect absolu possédé EXCLUSIVEMENT par ce chunk (hors zone dupliquée depuis un ancêtre) — les paintedRegionPx de tous les chunks approuvés doivent être disjoints.",
          "required": ["x", "y", "width", "height"],
          "properties": {
            "x": { "type": "integer" },
            "y": { "type": "integer" },
            "width": { "type": "integer", "minimum": 1 },
            "height": { "type": "integer", "minimum": 1 }
          }
        },
        "neighbors": {
          "type": "object",
          "properties": {
            "north": { "type": ["string", "null"] },
            "south": { "type": ["string", "null"] },
            "east": { "type": ["string", "null"] },
            "west": { "type": ["string", "null"] }
          }
        },
        "connectors": {
          "type": "object",
          "properties": {
            "north": { "type": "array", "items": { "$ref": "#/definitions/connector" } },
            "south": { "type": "array", "items": { "$ref": "#/definitions/connector" } },
            "east": { "type": "array", "items": { "$ref": "#/definitions/connector" } },
            "west": { "type": "array", "items": { "$ref": "#/definitions/connector" } }
          }
        }
      }
    },
    "connector": {
      "type": "object",
      "required": ["type", "position", "widthPx", "required"],
      "properties": {
        "type": { "type": "string", "enum": ["road", "river", "cliff", "forest", "bridge", "tunnel"] },
        "position": { "type": "number", "minimum": 0, "maximum": 1 },
        "widthPx": { "type": "number", "minimum": 1 },
        "direction": { "type": "string" },
        "priority": { "type": "integer" },
        "required": { "type": "boolean" },
        "transitionTheme": { "type": "string" },
        "note": { "type": "string" }
      }
    }
  }
}
