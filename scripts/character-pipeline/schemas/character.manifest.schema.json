{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Manifeste de personnage Eluminia",
  "type": "object",
  "required": [
    "characterId", "displayName", "version", "sourceReference", "visualStyle",
    "canonicalHeight", "canvasWidth", "canvasHeight", "anchorPoint",
    "groundPoint", "defaultScale", "directions", "renderOrder", "parts",
    "expressionStates", "animations", "generationHistory"
  ],
  "properties": {
    "characterId": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
    "displayName": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "sourceReference": { "type": "string" },
    "visualStyle": { "type": "string" },
    "canonicalHeight": { "type": "number", "exclusiveMinimum": 0 },
    "canvasWidth": { "type": "number", "exclusiveMinimum": 0 },
    "canvasHeight": { "type": "number", "exclusiveMinimum": 0 },
    "anchorPoint": { "$ref": "#/$defs/point01" },
    "groundPoint": { "$ref": "#/$defs/point01" },
    "defaultScale": { "type": "number", "exclusiveMinimum": 0 },
    "directions": { "type": "array", "items": { "enum": ["front", "back", "side"] }, "minItems": 1 },
    "renderOrder": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "parts": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/part" } },
    "expressionStates": { "type": "object" },
    "animations": { "type": "array", "items": { "type": "string" } },
    "generationHistory": { "type": "array", "items": { "$ref": "#/$defs/generation" } }
  },
  "$defs": {
    "point01": {
      "type": "object",
      "required": ["x", "y"],
      "properties": {
        "x": { "type": "number", "minimum": 0, "maximum": 1 },
        "y": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "part": {
      "type": "object",
      "required": ["id", "filename", "category", "parent", "zIndex", "pivotX", "pivotY", "attachmentX", "attachmentY", "mirrorable", "required", "status", "sourceGenerationId"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
        "filename": { "type": "string" },
        "category": { "enum": ["head", "body", "arms", "legs", "expression", "technical", "companion"] },
        "parent": { "type": "string" },
        "zIndex": { "type": "integer", "minimum": 0 },
        "pivotX": { "type": "number", "minimum": 0, "maximum": 1 },
        "pivotY": { "type": "number", "minimum": 0, "maximum": 1 },
        "attachmentX": { "type": "number", "minimum": 0, "maximum": 1 },
        "attachmentY": { "type": "number", "minimum": 0, "maximum": 1 },
        "mirrorable": { "type": "boolean" },
        "required": { "type": "boolean" },
        "status": { "enum": ["planned", "generated", "needs_review", "approved", "rejected", "superseded"] },
        "sourceGenerationId": { "type": ["string", "null"] }
      }
    },
    "generation": {
      "type": "object",
      "required": ["generationId", "date", "partId", "engine", "prompt", "referenceFiles", "outputFile", "estimatedCostUsd", "status"],
      "properties": {
        "generationId": { "type": "string" },
        "date": { "type": "string" },
        "partId": { "type": "string" },
        "engine": { "type": "string" },
        "prompt": { "type": "string" },
        "promptHash": { "type": "string" },
        "referenceFiles": { "type": "array", "items": { "type": "string" } },
        "referenceHash": { "type": "string" },
        "outputFile": { "type": "string" },
        "estimatedCostUsd": { "type": "number" },
        "status": { "enum": ["generated", "needs_review", "approved", "rejected", "superseded", "failed"] }
      }
    }
  }
}
