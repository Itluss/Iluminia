; Terres d'Émeraude — Action-RPG 2D (Godot 4.3)
; Projet pensé « mobile d'abord » : tactile, canvas redimensionnable, paysage.

config_version=5

[application]

config/name="Iluminia — Chasse au dragon"
run/main_scene="res://scenes/menu.tscn"
config/features=PackedStringArray("4.3", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

Audio="*res://scripts/audio.gd"
Profil="*res://scripts/profil.gd"

[display]

window/size/viewport_width=1024
window/size/viewport_height=576
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=4

[input_devices]

pointing/emulate_touch_from_mouse=true

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
